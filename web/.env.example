# Chain: 31337 = local anvil, 46630 = Robinhood Chain testnet
VITE_CHAIN_ID=31337
VITE_RPC_URL=http://127.0.0.1:8545
# Demo account: signs from a local key so the demo runs without MetaMask. Testnet only.
VITE_DEMO_PK=
VITE_BACKEND_URL=http://127.0.0.1:8787
VITE_WORLD_APP_ID=app_xxx
# 1 = show "Simulate World ID" (backend must run with WORLD_SIMULATE=1)
VITE_WORLD_SIMULATE=1
# Control position shown in the ?demo=1 strip
VITE_CONTROL_OWNER=
# Anvil #2 is the agent key in agent/src/chain.ts
VITE_AGENT_ADDRESS=
# Sent as x-demo-key to /api/demo/* (Friday close, Monday gap, agent attempt, reset). Ships in the bundle:
# it only gates demo buttons, never funds.
VITE_DEMO_KEY=
# Production (46630): .env.production sets chain, RPC and https://releash-api.robbyn.xyz; put the throwaway
# VITE_DEMO_PK in .env.production.local (gitignored).
