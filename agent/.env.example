# Chain: addresses come from deployments/<CHAIN_ID>.json
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
# Keys (default to anvil #0/#2/#3/#4/#5 on 31337 only)
KEEPER_PK=
AGENT_PK=
ALICE_PK=
CONTROL_PK=
LIQUIDATOR_PK=
# Owners the agent loop and liquidator watch (comma list); demo-setup prints this line
WATCH=
LOOP_MS=10000

# Decisions: Jev (OpenRouter decisions API) -> Claude fallback if Jev errors or confidence < JEV_MIN_CONFIDENCE -> rules
OPENROUTER_API_KEY=
AGENT_MODEL=~typesafe/jev-latest
FALLBACK_MODEL=anthropic/claude-haiku-4.5
JEV_MIN_CONFIDENCE=0.35
# AGENT_SOURCE=rules forces the deterministic rules (no API calls)
AGENT_SOURCE=
# Broadcast refused borrows with a fixed gas limit so the block is a reverted tx on chain (0 = simulate only)
BROADCAST_BLOCKED=1
# Lever-up ceiling and decay margin for agent borrows
LEVER_CAP_BPS=4900
DECAY_SAFETY_S=4

# demo-setup targets (USDG)
ALICE_DEBT=8000
CONTROL_DEBT=8800
AUTHORITY=9000
# keeper tick interval
TICK_MS=15000
