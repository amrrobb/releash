# Chain: addresses come from deployments/<CHAIN_ID>.json
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
PORT=8787
# Must be the key of the vault's immutable worldSigner (checked at boot). Defaults to anvil #1 on 31337.
WORLD_SIGNER_PK=
# Renewal deadline = issuedAt (chain time) + this
RENEWAL_TTL=600

# Local dev ONLY: skip the World Developer Portal and accept any idkitResult. Logged loudly.
WORLD_SIMULATE=0

# World ID v4 (Developer Portal)
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ACTION=releash-renew
WORLD_ENVIRONMENT=staging
# Staging proofs (World simulator) need the token of an open staging window
WORLD_STAGING_TOKEN=
WORLD_CREDENTIALS=proof_of_human
WORLD_VERIFY_URL=https://developer.world.org/api/v4/verify

# Optional overrides
# DB_PATH=
# AGENT_LOG=../agent/log.jsonl
# MARKET_FILE=../agent/market.json

# Demo routes (/api/demo/close, gap, reset, attempt-borrow). Off unless DEMO_ENABLED=1; every call
# needs header x-demo-key: $DEMO_KEY. They use the agent package's keys: KEEPER_PK, AGENT_PK,
# ALICE_PK, CONTROL_PK, LIQUIDATOR_PK (anvil defaults on 31337; on 46630 source ../.env.46630).
DEMO_ENABLED=0
DEMO_KEY=
